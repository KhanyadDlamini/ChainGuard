# Local demo environment. Copy to .env and fill in real values:
#   cp backend/.env.example backend/.env

# Postgres connection (password must match CHAINGUARD_DB_PASSWORD in root .env).
DATABASE_URL=postgresql+psycopg://chainguard_app:change-me@127.0.0.1:5544/chainguard

# Deployed ChainGuardToken address (from contracts/deployments/chainguard-local.json).
CHAINGUARD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Meta Model API key. Required for AI assessments; everything else works without it.
MODEL_API_KEY=

# Optional chain overrides (defaults shown).
# CHAINGUARD_RPC_URL=http://127.0.0.1:8545
# CHAINGUARD_CHAIN_ID=1337
